# Copy to .env.local (gitignored) and fill in with values from your
# Supabase project settings (Project Settings > API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public) - dashboard.cloudflare.com > Turnstile.
# The matching secret key is NOT an env var here - it's a Supabase Edge
# Function secret, set via `supabase secrets set TURNSTILE_SECRET_KEY=...`.
VITE_TURNSTILE_SITE_KEY=

# Optional, local dev only - skips rendering Turnstile and skips the real
# Cloudflare check in submit-form (which still runs against the live
# project, not a local one), so you can test form submissions without
# passing a real challenge. Only takes effect in `npm run dev` (never in a
# production build) AND only if this exact value also matches a
# TURNSTILE_DEV_BYPASS secret set via `supabase secrets set` - pick your own
# long random string, never reuse TURNSTILE_SECRET_KEY, never commit a real
# value here.
VITE_TURNSTILE_DEV_BYPASS=
